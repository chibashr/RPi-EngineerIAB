# Docker image for testing the installer on Debian Trixie (Raspberry Pi OS Trixie equivalent)
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# Minimal setup for installer preflight (curl, git, ca-certificates)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/workspace/bin/install.sh"]
