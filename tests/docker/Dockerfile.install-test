# Docker image for testing the RPi Engineer-in-a-Box installer
# Uses Ubuntu 22.04 to match supported OS
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Minimal setup for installer preflight
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy project into container (done at build or via mount)
WORKDIR /workspace

# Default: run installer (override with docker run for debugging)
CMD ["/workspace/bin/install.sh"]
